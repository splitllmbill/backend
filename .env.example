# MongoDB
MONGODB_URI=mongodb://localhost:27017
DB_NAME=splitllm

# Supabase (asymmetric JWT validation — the API verifies the access token
# against ${SUPABASE_URL}/auth/v1/.well-known/jwks.json)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role key (SECRET — never ships to clients). Required for QR/device
# login; also lets account deletion remove the Supabase auth record.
SUPABASE_SERVICE_ROLE_KEY=

# LLM — Catalyst QuickML LLM Serving (GLM text + Qwen vision-language).
# Disabled until the endpoints below are set. On AppSail use the QUICKML_/OAUTH_
# prefixed names (env vars starting with ZOHO_/CATALYST_ are rejected as reserved).
LLM_ENABLED=false
QUICKML_LLM_ENDPOINT=
QUICKML_LLM_MODEL=glm-4.7-flash
QUICKML_VLM_ENDPOINT=
QUICKML_VLM_MODEL=qwen3.6-35b-vl
QUICKML_ORG_ID=
OAUTH_ACCOUNTS_URL=https://accounts.zoho.in
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=

# Currency / FX (external endpoint is user-managed; leave empty to fall back to
# the fx_rates Mongo collection, then identity 1.0)
DEFAULT_CURRENCY=INR
FX_API_URL=

# ZeptoMail (transactional email — invites, password resets)
ZEPTOMAIL_ENABLED=false
ZEPTOMAIL_API_URL=https://api.zeptomail.in
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=noreply@splitllm.com
ZEPTOMAIL_FROM_NAME=SplitLLM

# PayPal settlements (PayPal AI Hackathon entry). Standard REST app
# credentials from the PayPal Developer Dashboard (developer.paypal.com).
# Leave empty to disable PayPal settlements (endpoints return 503); the
# rest of the app is unaffected. Sandbox first — set PAYPAL_ENVIRONMENT=live
# only with live credentials. PAYPAL_WEBHOOK_ID is the id of the webhook
# registered in the dashboard (for PAYMENT.CAPTURE.COMPLETED events);
# RETURN_URL / CANCEL_URL are the frontend pages PayPal sends the payer
# back to after approval / cancellation.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=

# Public URL of the web app (used in email links)
APP_BASE_URL=https://splitllm.com

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# Server
HOST=0.0.0.0
PORT=8081
